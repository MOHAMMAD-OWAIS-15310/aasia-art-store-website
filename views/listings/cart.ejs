<% layout("/layouts/boilerplate.ejs") %>
<body>
    <h2 class="mt-3 mb-3 ">My Cart</h2>
    <% if(cart.length === 0){ %>
        <p>Your cart is empty</p>
    <% } %>

    <% let total = 0; %>

    <% for(let item of cart){ %>
        <% if(item.listing){ %>
            <% total += item.listing.price; %>
            <div class="cart-one">
                <a href="/listings/<%= item.listing._id %>">
                    <img src="<%= item.listing.image.url %>" alt="painting" height="120px" width="170px">
                </a>
                <div class= "cart-detail" >
                    <p><b>Title:</b> <%= item.listing.title %></p>
                    <p> <b>Price:</b> ₹<%= item.listing.price.toLocaleString("en-IN") %></p>
                    <form method="post" action="/listings/<%= item.listing._id %>/remove">
                            <button class="btn btn-danger">Remove</button>
                    </form>
                 </div>
            </div>
            <hr>

        <% }  %>
     <% } %>

    <% if(cart.length > 0){ %>
        <h4>Total: ₹<%= total.toLocaleString("en-IN") %></h4>
        <form method="get" action="/listings/cart">
            <button class="btn btn-dark mt-3">Proceed to Buy</button>
        </form>
    <% } %>

</body>